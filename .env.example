# Required: OpenAI API key (the reviewer's own key)
OPENAI_API_KEY=

# Optional: model and reasoning effort (effort is only sent to gpt-5*/o* reasoning models)
OPENAI_MODEL=gpt-5.4-mini
OPENAI_REASONING_EFFORT=none

# Optional: any OpenAI-compatible endpoint instead of api.openai.com
# (e.g. Azure OpenAI, OpenRouter, a local vLLM/Ollama server). The model must support tool calling
# and JSON-schema structured output.
# OPENAI_BASE_URL=

# Optional: data locations (defaults shown)
# DATA_DIR=./data
# RAW_DIR=./data/raw
# PARSED_DIR=./data/parsed
# DB_PATH=./data/wellchat.db
