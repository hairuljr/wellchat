# Wajib: API key OpenAI (key milik reviewer)
OPENAI_API_KEY=

# Opsional: model dan reasoning effort default (effort hanya dikirim ke model reasoning gpt-5*/gpt-6*/o*,
# dan juga dipakai entri MODEL_ALLOWLIST tanpa `@effort`)
# Model harus mendukung tool calling dan structured output (JSON schema).
OPENAI_MODEL=gpt-5.4-mini
OPENAI_REASONING_EFFORT=none

# Opsional: endpoint lain yang kompatibel dengan OpenAI, sebagai pengganti api.openai.com
# (misalnya Azure OpenAI, OpenRouter, atau server vLLM/Ollama lokal). Modelnya harus mendukung
# tool calling dan structured output (JSON schema). OPENAI_API_KEY diisi key dari penyedia tersebut.
# OPENAI_BASE_URL=

# Opsional: model lain yang boleh dipilih lewat dropdown di UI, dipisah koma. Hanya model
# yang tersedia di endpoint yang ditampilkan. Tulis `model@effort` (misalnya `@low`) untuk model
# yang butuh reasoning effort berbeda dari OPENAI_REASONING_EFFORT. Kosongkan untuk memakai
# OPENAI_MODEL saja.
# MODEL_ALLOWLIST=

# Opsional: batas waktu satu jawaban (detik). Putaran tool berhenti lebih awal supaya
# jawaban akhir tetap selesai dalam batas ini.
# ANSWER_DEADLINE_S=150
# Waktu yang disisihkan khusus untuk jawaban akhir, tidak dipakai putaran tool.
# FINAL_ROUND_RESERVE_S=30

# Opsional: batas karakter untuk satu hasil tool sebelum dipangkas (tetap JSON yang valid).
# Naikkan bila model punya context window besar; turunkan bila permintaan terasa lambat.
# MAX_TOOL_RESULT_CHARS=14000

# Opsional: lokasi data (nilai default)
# DATA_DIR=./data
# RAW_DIR=./data/raw
# PARSED_DIR=./data/parsed
# DB_PATH=./data/wellchat.db
